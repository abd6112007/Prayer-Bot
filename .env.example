# ============================================================
#  انسخ هذا الملف إلى .env (للتشغيل المحلي فقط) وعدّل القيم
#  على GitHub تُوضع القيم الحساسة في: Settings → Secrets → Actions
# ============================================================

# --- (سرّي) كلمة سر تشفير الجلسة — 32 حرفاً عشوائياً على الأقل ---
# لتوليدها:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PASSPHRASE=

# --- (سرّي) معرّفات المجموعات، مفصولة بفاصلة — تحصل عليها من: npm run groups ---
GROUP_IDS=

# --- إعدادات اختيارية (القيم الافتراضية مناسبة لغزة) ---
# طريقة حساب المواقيت في Aladhan: 5 = الهيئة المصرية العامة للمساحة (الافتراضي)
#   ملاحظة: قارن النتيجة بجدول وزارة الأوقاف في غزة، وعدّل الطريقة أو PRAYER_TUNE إن لزم
# PRAYER_METHOD=5
# المذهب في العصر: 0 = جمهور (الشافعي/المالكي/الحنبلي)، 1 = حنفي
# PRAYER_SCHOOL=0
# تعديل بالدقائق بالترتيب: الإمساك,الفجر,الشروق,الظهر,العصر,المغرب,الغروب,العشاء,منتصف الليل
# PRAYER_TUNE=0,0,0,0,0,0,0,0,0
# إظهار التاريخ الهجري في الرسالة، وتعديله بالأيام (+1 أو -1) إن اختلف عن التقويم المحلي
# SHOW_HIJRI=true
# HIJRI_ADJUSTMENT=0
# LATITUDE=31.5017
# LONGITUDE=34.4668
# CITY_NAME=غزة، فلسطين
# أقصى تأخير مسموح لإرسال تنبيه فاتَه موعده (بالدقائق)
# LATE_GRACE_MINUTES=15

# --- رسالة الترحيب (تُرسل مرة واحدة فقط لكل مجموعة، وليس عند كل إقلاع) ---
# SEND_WELCOME=true          # اجعلها false لتعطيلها
# WELCOME_VERSION=1          # غيّرها إلى 2 مثلاً لإعادة إرسال الترحيب لكل المجموعات

# إن تعذّر الاتصال بواتساب أكثر من هذه المدة (دقائق) تنتهي النسخة بخطأ واضح بدل أن تعلق
# DISCONNECT_LIMIT_MINUTES=10
